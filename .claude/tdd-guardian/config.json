{
  "schemaVersion": 2,
  "enabled": true,
  "enforceOnTaskCompleted": false,
  "blockCommitWithoutFreshGate": false,
  "staleGateAction": "deny",
  "gateFreshnessMinutes": 120,
  "smartStaleness": true,
  "bypassEnv": "TDD_GUARD_BYPASS",
  "preflightCommand": "",
  "lanes": [
    {
      "name": "release-appcast-node",
      "description": "Manual Node contract receipts for appcast generation and final/RC feed validity (#629).",
      "command": "node scripts/tdd/node-lane.mjs scripts/release/appcast.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "unit",
      "description": "Unchanged full parallel MadoKit tests with coverage; 600-second watchdog after heavy-lock admission. Outer bound includes up to 7200 seconds of lock waiting and diagnostic/cleanup margin (#632).",
      "command": "node scripts/tdd/unit-lane.mjs",
      "coverageReportCommand": "sh scripts/tdd/swift-lcov.sh",
      "gateOn": [
        "taskCompleted",
        "commit"
      ],
      "coverage": "include",
      "coverageSummaryPath": "coverage/lcov.info",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/MadoKit --list-tests",
      "timeoutMs": 9000000
    },
    {
      "name": "integration",
      "description": "Real filesystem/security-scope adapter and Session/admission/ImageIO regression paths for File Grants; native sandbox delivery remains signed device smoke.",
      "command": "node scripts/tdd/swift-lane.mjs 'issue73SystemScopeReadabilityReflectsRealFiles|issue73ReadableDropSessionOpensEmptyThenReplacesAndRejectsZIP|accessSystemAdapterCreatesAndResolvesRealBookmark|issue140SystemFileBookmarkFollowsSameVolumeRename'",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/MadoKit --list-tests --filter 'issue73SystemScopeReadabilityReflectsRealFiles|issue73ReadableDropSessionOpensEmptyThenReplacesAndRejectsZIP|accessSystemAdapterCreatesAndResolvesRealBookmark|issue140SystemFileBookmarkFollowsSameVolumeRename'",
      "timeoutMs": 600000
    },
    {
      "name": "swift-red",
      "description": "Selected SwiftPM test for RED receipts. Set PICSEE_SWIFT_FILTER on both record and verify; --files only selects fingerprints.",
      "command": "node scripts/tdd/swift-lane.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh swift test --package-path Packages/MadoKit --list-tests",
      "timeoutMs": 600000
    },
    {
      "name": "app-red",
      "description": "Compiled MadoAppTests. Optional PICSEE_APP_FILTER selects runtime test IDs; keep the same filter for record and verify (env is not stored in receipts). Set PICSEE_APP_LANE_NO_RETRY=1 for RED. Build-for-testing before RED record.",
      "setupCommand": "scripts/heavy-lock.sh xcodebuild build-for-testing -scheme Mado -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO -derivedDataPath .build/dd-ci -only-testing:MadoAppTests",
      "command": "node scripts/tdd/app-lane.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "scripts/heavy-lock.sh xcodebuild -list -project Mado.xcodeproj",
      "timeoutMs": 2400000
    },
    {
      "name": "release-node",
      "description": "Release tooling node tests (signed-app entitlement checker, #220). Pure parse/compare logic; no codesign.",
      "command": "node scripts/tdd/node-lane.mjs scripts/release/check-entitlements.test.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "node --version",
      "timeoutMs": 120000
    },
    {
      "name": "name-check-node",
      "command": "node scripts/tdd/node-lane.mjs scripts/name-checks/identity-transition.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "module-name-node",
      "command": "node scripts/tdd/node-lane.mjs scripts/name-checks/module-name.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "docs-node",
      "command": "node scripts/tdd/node-lane.mjs scripts/name-checks/living-docs.test.mjs scripts/name-checks/docs-fix.test.mjs scripts/design/design-prompts.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000,
      "description": "Manual lightweight documentation RED receipts and current-identity/export contracts; node --version discovery needs no native heavy lock."
    },
    {
      "name": "ci-cache-node",
      "command": "node scripts/tdd/node-lane.mjs scripts/ci/cache-key.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "ci-flaky-node",
      "description": "Manual Node-only receipts for App quarantine validation and exact CI flake classification (#587). Does not launch App tests.",
      "command": "node scripts/tdd/node-lane.mjs scripts/ci/flaky-gate.test.mjs scripts/tdd/app-lane.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "release-tag-ci-node",
      "command": "node scripts/tdd/node-lane.mjs scripts/release/check-tag-ci.test.mjs scripts/release/release-workflow.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "unit-watchdog-node",
      "description": "Manual Node process/owner contract receipts for bounded local Swift runs (#632).",
      "command": "node scripts/tdd/node-lane.mjs scripts/tdd/unit-lane.test.mjs .agents/skills/picsee-delegator/scripts/owner-gates.test.mjs scripts/tdd/unit-startup.test.mjs",
      "probeCommand": "node --version",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "timeoutMs": 120000
    },
    {
      "name": "app-prebuilt-red",
      "description": "#393 prebuilt App lane RED. Build once via foreground heavy-lock outside receipt setup. Keep PICSEE_APP_FILTER and NO_RETRY identical for record/verify.",
      "command": "node scripts/tdd/app-lane.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "node --version",
      "timeoutMs": 2400000
    },
    {
      "name": "ci-hosted-focus-node",
      "description": "Manual amendment2 hosted diagnostic CI bootstrap contracts. No native work.",
      "command": "node scripts/tdd/node-lane.mjs scripts/ci/hosted-focus-ci.test.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "node --version",
      "timeoutMs": 120000
    },
    {
      "name": "ci-native-red-node",
      "description": "Manual Node contracts for optional official native RED verification and full App CI validation.",
      "command": "node scripts/tdd/node-lane.mjs scripts/ci/native-red-ci.test.mjs",
      "gateOn": [
        "manual"
      ],
      "coverage": "none",
      "probeCommand": "node --version",
      "timeoutMs": 120000
    }
  ],
  "coverageThresholds": {
    "lines": 100,
    "functions": 100,
    "branches": 0,
    "statements": 100
  },
  "coverageMode": "absolute",
  "requireMutation": false,
  "mutationCommand": "",
  "mutationGateOn": [
    "push"
  ]
}
