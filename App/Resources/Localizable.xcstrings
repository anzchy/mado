    "Annotation Tools":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Annotation Tools"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标注工具"}}}},
    "Save the annotations on “%@”?":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Save the annotations on “%@”?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"要存储对“%@”的标注吗？"}}}},
    "Save keeps the original unchanged and saves a copy as %@. Don't Save discards these marks.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Save keeps the original unchanged and saves a copy as %@. Don't Save discards these marks."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"存储会另存为 %@，原图不变。不存储则丢弃这些标记。"}}}},
    "Image Context Menu":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Image Context Menu"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"图片上下文菜单"}}}},
    "Quick Look":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Look"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快速查看"}}}},
    "Show in Finder":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show in Finder"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在访达中显示"}}}},
    "Copy Path":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Path"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拷贝路径"}}}},
    "Get Info":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Get Info"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"图片信息"}}}},
    "Can’t Find “%@”": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Can’t Find “%@”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"找不到“%@”"}}}},
    "Unable to Access “%@”": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to Access “%@”"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法访问“%@”"}}}},
    "Not Found":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not Found"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"找不到"}}}},
    "Choose at New Location…":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose at New Location…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在新位置选择…"}}}},
    "Mado can’t find “%@”. Choose its location, or choose another folder to continue.":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"It may have been deleted, put in the Trash, or be on a different disk. If it’s elsewhere, choose it at its new location to continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"它可能已被删除、放进了废纸篓，或不在原来的磁盘上。\n如果它在别处，在新位置重新选择它即可继续。"}}}},
    "Updated to %@":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Updated to %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已更新到 %@"}}}},
    "Dismiss Location Update":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dismiss Location Update"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭位置更新提示"}}}},
    "Access Has Expired": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Access Has Expired"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"授权失效"}}}},
    "Access has expired. Choose this folder again to restore access; Mado will return to where you left off.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Access has expired. Choose this folder again to restore access; Mado will return to where you left off."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"访问权限已失效。重新选择这个文件夹即可恢复，Mado 会回到你刚才的位置。"}}}},
    "Coming Soon": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Coming Soon"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "即将推出"}}}},
    "Personal Favorites": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Personal Favorites"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "个人收藏"}}}},
    "Recently Viewed": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Recently Viewed"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "最近查看"}}}},
    "Show Image Information": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Show Image Information"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "显示图片信息"}}}},
    "Close Display Panel": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Close Display Panel"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "关闭显示面板"}}}},
    "Display and Appearance": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Display and Appearance"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "显示与外观"}}}},
    "Help": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Help"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "帮助"}}}},
    "Report a Problem…": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Report a Problem…"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "报告问题…"}}}},
    "Keyboard Shortcuts": {"extractionState": "manual","localizations": {"en": {"stringUnit": {"state": "translated","value": "Keyboard Shortcuts"}},"zh-Hans": {"stringUnit": {"state": "translated","value": "键盘快捷键"}}}},
    "%@ (build %@)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%@ (build %@)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@（构建 %@）"}}}},
    "A macOS image viewer for files on your disk. Mado collects no data. Images stay on your Mac. The only exception is Cloud Recognition, which is off until you turn it on with your own service key and agree; it then sends only the image you ask to recognise (text or table) to the service you chose. The sandbox reads only folders you choose.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A macOS image viewer for files on your disk. Mado collects no data. Images stay on your Mac. The only exception is Cloud Recognition, which is off until you turn it on with your own service key and agree; it then sends only the image you ask to recognise (text or table) to the service you chose. The sandbox reads only folders you choose."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "一个直接浏览磁盘上图片的 macOS 看图应用。Mado 不收集数据，图片留在本机；唯一例外是云识别：需你主动开启、使用自己的服务密钥并同意，才会把你要识别的那张图片（文字或表格）发送给你选择的服务。沙盒开启，只读取你选择的文件夹。"}}}},
    "About": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "About"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关于"}}}},
    "Always Show Image Tools": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Always Show Image Tools"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "始终显示大图工具"}}}},
    "Cache": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cache"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "缓存"}}}},
    "Auto Check": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Auto Check"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动检查更新"}}}},
    "Check Now": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check Now"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "立即检查"}}}},
