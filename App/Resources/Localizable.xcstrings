    "Only thumbnails created by Mado are deleted. Your images are untouched; thumbnails are rebuilt while browsing.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only thumbnails created by Mado are deleted. Your images are untouched; thumbnails are rebuilt while browsing."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只删除 Mado 生成的缩略图，不会动你的图片；清理后浏览时重新生成。"}}}},
    "Privacy Note": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Privacy Note"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "隐私说明"}}}},
