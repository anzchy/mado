    "A weak mosaic can be reversed to reveal text; use a solid box for anything truly secret.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A weak mosaic can be reversed to reveal text; use a solid box for anything truly secret."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"强度低的马赛克可能被还原出文字；真正保密的内容请用实色块。"}}}},
    "Use Solid Box":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Solid Box"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"改用实色块"}}}},
    "Solid black box; cannot be reversed.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Solid black box; cannot be reversed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"纯黑色块，不可还原。"}}}},
