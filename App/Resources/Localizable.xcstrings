    "Saved %@, but clipboard copy failed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved %@, but clipboard copy failed"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已存储 %@，但复制到剪贴板失败"}}}},
    "Capture in progress": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Capture in progress"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "截图正在进行"}}}},
    "Capture failed: %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Capture failed: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "截图失败：%@"}}}},
    "Capture requires Screen & System Audio Recording, which is currently denied. System Settings has been opened.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Capture requires Screen & System Audio Recording, which is currently denied. System Settings has been opened."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "截图需要「录屏与系统录音」权限，目前被拒绝。已打开系统设置。"}}}},
    "Baidu Cloud Recognition": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Baidu Cloud Recognition"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "百度云识别"}}}},
    "Copied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Copied"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已拷贝"}}}},
    "Copied %lld characters": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Copied %lld characters"}, "variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Copied %lld character"}}, "other": {"stringUnit": {"state": "translated", "value": "Copied %lld characters"}}}}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已拷贝 %lld 个字符"}}}},
    "Couldn't copy the text · The clipboard may have changed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't copy the text · The clipboard may have changed"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能拷贝文字 · 剪贴板可能已改变"}}}},
    "No text found · Clipboard unchanged": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No text found · Clipboard unchanged"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未找到文字 · 剪贴板没有改变"}}}},
    "On-device Recognition": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "On-device Recognition"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本机识别"}}}},
    "Recognise Text": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recognise Text"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "识别文字"}}}},
    "Recognise Table…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recognise Table…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "识别表格…"}}}},
    "Recognise Table": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recognise Table"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "识别表格"}}}},
    "Send this image to %@ to recognise the table?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send this image to %@ to recognise the table?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将这张图片发送到 %@ 识别表格？"}}}},
    "The image leaves your Mac, is processed by that service, and its privacy policy applies. You can turn off Cloud Recognition in Settings at any time.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The image leaves your Mac, is processed by that service, and its privacy policy applies. You can turn off Cloud Recognition in Settings at any time."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "图片会离开你的 Mac，由该服务处理，并适用其隐私政策。你可以随时在设置中关闭云识别。"}}}},
    "Consent covers only this server; a different address asks again.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Consent covers only this server; a different address asks again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "同意只对这个服务器有效；换了地址会再问一次。"}}}},
    "Agree and Recognise": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Agree and Recognise"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "同意并识别"}}}},
    "Recognising table…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recognising table…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在识别表格…"}}}},
    "The image was sent to %@. This usually takes a few seconds to over ten seconds.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The image was sent to %@. This usually takes a few seconds to over ten seconds."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "图片已发送到 %@。通常几秒到十几秒。"}}}},
    "Cancelling doesn't retry automatically; a request already sent may have been charged.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cancelling doesn't retry automatically; a request already sent may have been charged."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消后不会自动重试；已发送的请求可能已产生费用。"}}}},
    "Table recognised · %@, %@ (including header) · %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Table recognised · %@, %@ (including header) · %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "表格已识别 · 共 %@、%@（含表头） · %@"}}}},
    "Table recognised · %@, %@ · %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Table recognised · %@, %@ · %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "表格已识别 · 共 %@、%@ · %@"}}}},
    "%lld row": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld row"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 行"}}}},
    "%lld rows": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld rows"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 行"}}}},
    "%lld column": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld column"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 列"}}}},
    "%lld columns": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld columns"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 列"}}}},
    "Check the text and the rows and columns.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check the text and the rows and columns."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请核对文字与行列。"}}}},
    "Original": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Original"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原图"}}}},
    "Pasted into Word it is a complete table; pasted as plain text it is tab-separated text.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pasted into Word it is a complete table; pasted as plain text it is tab-separated text."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "粘贴到 Word 是完整的表格；粘贴到纯文本是用制表符分隔的文字"}}}},
    "Copy Table": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Copy Table"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拷贝表格"}}}},
    "Table copied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Table copied"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "表格已拷贝"}}}},
    "Cloud Recognition is off": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cloud Recognition is off"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "云识别已关闭"}}}},
    "Turn on Allow Cloud Recognition in Settings to recognise tables. No image has been sent.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Turn on Allow Cloud Recognition in Settings to recognise tables. No image has been sent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "识别表格需要把图片发送到识别服务。你可以在设置里打开「允许云识别」；目前尚未发送图片。"}}}},
    "Connect a recognition service first": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Connect a recognition service first"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "首次使用需要连接识别服务"}}}},
    "Set up Table Recognition in Settings. No image has been sent.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Set up Table Recognition in Settings. No image has been sent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先在设置里连接表格识别服务；目前尚未发送图片。"}}}},
    "This image is too large": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This image is too large"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这张图片太大"}}}},
    "It is larger than the service allows and was not sent.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "It is larger than the service allows and was not sent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "超过服务允许的大小，没有发送。"}}}},
    "Couldn't recognise the table": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't recognise the table"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法识别表格"}}}},
    "The image was not sent. Nothing was copied.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The image was not sent. Nothing was copied."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "图片没有发送出去，也没有拷贝任何内容。"}}}},
    "Nothing was copied. The original image and the clipboard are unchanged.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Nothing was copied. The original image and the clipboard are unchanged."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有拷贝任何内容；原图和剪贴板都没有改动。"}}}},
    "Recognised Text": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recognised Text"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "识别出的文字"}}}},
    "Unable to recognise text": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unable to recognise text"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法识别文字"}}}},
    "You can edit before copying again": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "You can edit before copying again"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "可以修改后再拷贝"}}}},
    "Allow": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Allow"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "允许"}}}},
    "Allow Cloud Recognition (Recognise Text, Recognise Table)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Allow Cloud Recognition (Recognise Text, Recognise Table)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "允许云识别（识别文字、识别表格）"}}}},
    "Only when you click Recognise Text or Recognise Table is that image sent; selecting text on an image uses only on-device recognition.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only when you click Recognise Text or Recognise Table is that image sent; selecting text on an image uses only on-device recognition."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只在你点「识别文字」或「识别表格」时，才把那张图片发送出去；在图片上选字只用本机。"}}}},
    "No Access Key": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No Access Key"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未填写访问密钥"}}}},
    "Baidu Terms of Service": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Baidu Terms of Service"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "百度服务条款"}}}},
    "Recognition Service": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recognition Service"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "识别服务"}}}},
    "Keys": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Access Keys"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "访问密钥"}}}},
    "Save to Keychain": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save to Keychain"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "保存到钥匙串"}}}},
    "Keys are kept in the macOS Keychain.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Keys are kept in the macOS Keychain."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "访问密钥保存在 macOS 钥匙串中。"}}}},
    "Remove Access Keys": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remove Access Keys"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "移除访问密钥"}}}},
    "API Key %1$@ · Secret Key %2$@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "API Key %1$@ · Secret Key %2$@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "API Key %1$@ · Secret Key %2$@"}}}},
    "Without an access key, offline, or when the quota is used up, Recognise Text falls back to on-device recognition and says so; Recognise Table needs Cloud Recognition.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Without an access key, offline, or when the quota is used up, Recognise Text falls back to on-device recognition and says so; Recognise Table needs Cloud Recognition."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有访问密钥、离线或额度用完时，「识别文字」会改用本机识别并标明；「识别表格」只能用云识别。"}}}},
    "Save the access keys first.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save the access keys first."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先保存访问密钥。"}}}},
    "Enter both the API Key and the Secret Key.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter both the API Key and the Secret Key."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请填写 API Key 和 Secret Key。"}}}},
    "The access keys could not be saved to the macOS Keychain.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The access keys could not be saved to the macOS Keychain."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能把访问密钥存到 macOS 钥匙串。"}}}},
    "The access keys could not be removed from the macOS Keychain.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The access keys could not be removed from the macOS Keychain."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能从 macOS 钥匙串移除访问密钥。"}}}},
    "Use Baidu to recognise text?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Use Baidu to recognise text?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "要用百度识别文字吗？"}}}},
    "Only the image you ask to recognise is sent to Baidu after you agree for this service host and choose Recognise Text. Selecting text directly on an image always uses on-device recognition only. Baidu’s terms apply. Baidu text recognition needs a Baidu account with real-name verification; its documentation lists only mainland Chinese ID documents. How long Baidu keeps images and whether its service works outside mainland China are unconfirmed.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only the image you ask to recognise is sent to Baidu after you agree for this service host and choose Recognise Text. Selecting text directly on an image always uses on-device recognition only. Baidu’s terms apply. Baidu text recognition needs a Baidu account with real-name verification; its documentation lists only mainland Chinese ID documents. How long Baidu keeps images and whether its service works outside mainland China are unconfirmed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只有你同意向这个服务主机上传并选择「识别文字」后，才会把你要识别的那张图片发送给百度。在图片上直接选字永远只用本机识别。上传适用百度服务条款。百度文字识别需要完成实名认证的百度账号，百度文档只列出中国大陆证件。百度保存图片的期限及在中国大陆以外能否使用，尚未确认。"}}}},
    "Agree and Turn On": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Agree and Turn On"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "同意并打开"}}}},
    "Table Recognition": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Table Recognition"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "表格识别"}}}},
    "Access Key": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Access Key"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "访问密钥"}}}},
    "Images Sent To": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Images Sent To"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "图片发送到"}}}},
    "Test": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Test"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "测试"}}}},
    "Address": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Address"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "地址"}}}},
    "Model": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Model"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型"}}}},
    "Custom": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Custom"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自定义"}}}},
    "Table Recognition Service": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Table Recognition Service"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "表格识别服务"}}}},
    "Paste the access key (API Key)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Paste the access key (API Key)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "粘贴访问密钥（API Key）"}}}},
    "Saved to Keychain": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved to Keychain"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已保存到钥匙串"}}}},
    "Replace…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Replace…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "更换…"}}}},
    "Remove": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remove"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "移除"}}}},
    "No key yet?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No key yet?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "还没有密钥？"}}}},
    "How to Get One ↗": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "How to Get One ↗"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "怎么获取 ↗"}}}},
    "Images are sent here only after you click Recognise Table.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Images are sent here only after you click Recognise Table."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只在你点「识别表格」后，图片才发送到这里。"}}}},
    "Privacy ↗": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Privacy ↗"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "隐私说明 ↗"}}}},
    "Sends a built-in sample, not your images; the service may charge.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sends a built-in sample, not your images; the service may charge."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "发送内置示例，不发送你的图片；服务可能收费。"}}}},
    "Save a key to test.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save a key to test."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "填写并保存密钥后可测试。"}}}},
    "Advanced": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Advanced"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "高级"}}}},
    "Service Address": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Service Address"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "服务地址"}}}},
    "https://… (required, OpenAI-compatible)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "https://… (required, OpenAI-compatible)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "https://…（必填，需要 OpenAI 兼容）"}}}},
    "Model name (must read images)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Model name (must read images)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型名称（必须能读图片）"}}}},
    "A custom service needs an address and a model.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A custom service needs an address and a model."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自定义服务必须填写地址和模型。"}}}},
    "Changing the address removes the saved key; save it and agree again.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changing the address removes the saved key; save it and agree again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "换地址会移除已保存的密钥，需要重新保存并同意。"}}}},
    "Could not remove the saved key. The address was not changed.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not remove the saved key. The address was not changed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法移除已保存的密钥，地址未更改。"}}}},
    "(Enter the model first)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "(Enter the model first)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "（先填写模型）"}}}},
    "Test again after changing the model.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Test again after changing the model."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "改模型后请重新测试。"}}}},
    "May use your service account's balance; check the service for charges.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "May use your service account's balance; check the service for charges."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "可能使用服务账户的余额，费用请到该服务查看。"}}}},
    "Learn More ↗": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Learn More ↗"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "了解更多 ↗"}}}},
    "(Enter the address first)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "(Enter the address first)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "（先填写地址）"}}}},
    "Testing…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Testing…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在测试…"}}}},
    "Test passed: the sample table can be recognised.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Test passed: the sample table can be recognised."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "测试成功，可以识别示例表格。"}}}},
    "The key was not accepted. Replace the key.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The key was not accepted. Replace the key."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "密钥不被接受，请更换密钥。"}}}},
    "Can't connect to this address. Check the address under Advanced.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Can't connect to this address. Check the address under Advanced."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法连接这个地址，请检查「高级」里的地址。"}}}},
    "This model doesn't support images. Choose another model.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This model doesn't support images. Choose another model."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这个模型不支持图片，请换一个模型。"}}}},
    "Can't connect to the internet. Check the network and try again.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Can't connect to the internet. Check the network and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法联网，请检查网络后重试。"}}}},
    "Not enough balance. Check your service account.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not enough balance. Check your service account."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "额度不足，请到服务账户检查。"}}}},
    "Test failed.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Test failed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "测试未通过。"}}}},
    "Cloud Recognition is off. Nothing was sent.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cloud Recognition is off. Nothing was sent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "云识别已关闭，没有发送。"}}}},
    "Enter the access key.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter the access key."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请填写访问密钥。"}}}},
    "The key could not be saved to the keychain.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The key could not be saved to the keychain."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能把密钥存到钥匙串。"}}}},
    "The key could not be removed from the keychain.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The key could not be removed from the keychain."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能从钥匙串移除密钥。"}}}},
    "Send images to %@ to recognise tables?": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send images to %@ to recognise tables?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将图片发送到 %@ 识别表格？"}}}},
    "Images leave your Mac, are processed by that service, and its privacy policy applies. You can turn off Cloud Recognition in Settings at any time. Consent covers only this server; a different address asks again. Test sends only the built-in sample.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Images leave your Mac, are processed by that service, and its privacy policy applies. You can turn off Cloud Recognition in Settings at any time. Consent covers only this server; a different address asks again. Test sends only the built-in sample."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "图片会离开你的 Mac，由该服务处理，并适用其隐私政策。你可以随时在设置中关闭云识别。同意只对这个服务器有效；换了地址会再问一次。测试只发送内置示例。"}}}},
    "Agree and Test": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Agree and Test"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "同意并测试"}}}}
  },
  "version": "1.0"
}
