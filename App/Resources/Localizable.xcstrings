    "These settings sync with Display in the Grid Bottom Bar; changes take effect immediately in either place.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "These settings sync with Display in the Grid Bottom Bar; changes take effect immediately in either place."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "与网格底栏的「显示」设置同步，任一处修改立即生效。"}}}},
    "This deletes Mado thumbnails only. Your images are untouched.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This deletes Mado thumbnails only. Your images are untouched."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只删除 Mado 生成的缩略图，不会动你的图片。"}}}},
    "Thumbnail Size": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Thumbnail Size"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "缩略图大小"}}}},
    "Tool Background Opacity": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Tool Background Opacity"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "工具背景不透明度"}}}},
