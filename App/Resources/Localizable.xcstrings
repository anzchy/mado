{
  "sourceLanguage": "en",
  "strings": {
    "Type Shortcut…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Type Shortcut…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请按快捷键…"}}}},
    "%@ Shortcut": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%@ Shortcut"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@快捷键"}}}},
    "Click, then press the new shortcut": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Click, then press the new shortcut"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "点按后按下新的快捷键"}}}},
    "Restore Defaults": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Restore Defaults"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复默认"}}}},
    "A shortcut needs ⌘, ⌃ or ⌥.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A shortcut needs ⌘, ⌃ or ⌥."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "快捷键需要包含 ⌘、⌃ 或 ⌥。"}}}},
    "A shortcut needs a key besides the modifiers.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A shortcut needs a key besides the modifiers."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "快捷键需要一个修饰键以外的按键。"}}}},
    "%@ is a macOS screenshot shortcut and stays with the system.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%@ is a macOS screenshot shortcut and stays with the system."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@ 是 macOS 的截图快捷键，留给系统使用。"}}}},
    "%1$@ is already used by %2$@.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%1$@ is already used by %2$@."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%1$@ 已用于「%2$@」。"}}}},
    "%@ is used by another app. Choose another shortcut.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%@ is used by another app. Choose another shortcut."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@ 已被其他 App 占用，请换一个快捷键。"}}}},
    "The chosen folder %@ can't be opened, so captures go to ~/Downloads. Choose it again.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The chosen folder %@ can't be opened, so captures go to ~/Downloads. Choose it again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法打开所选文件夹 %@，截图暂存到 ~/Downloads。请重新选择。"}}}},
    "Mado Capture needs your approval in System Settings › General › Login Items.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mado Capture needs your approval in System Settings › General › Login Items."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "需要在「系统设置 › 通用 › 登录项」中允许 Mado 截图。"}}}},
    "The login item could not be removed, so the capture helper may still start at login.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The login item could not be removed, so the capture helper may still start at login."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能移除登录项，登录时仍可能启动截图助手。"}}}},
    "A global shortcut needs ⌘ or ⌃; macOS does not allow ⌥ or ⌥⇧ alone.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A global shortcut needs ⌘ or ⌃; macOS does not allow ⌥ or ⌥⇧ alone."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "全局快捷键需要包含 ⌘ 或 ⌃，macOS 不允许只用 ⌥ 或 ⌥⇧。"}}}},
    "Open Login Items Settings": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open Login Items Settings"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开登录项设置"}}}},
    "The capture helper could not be added as a login item: %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The capture helper could not be added as a login item: %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未能添加登录项：%@"}}}},
    "Click to show the Capture Bar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Click to show the Capture Bar"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "点按显示截图工具条"}}}},
    "Mado Capture: click to show the Capture Bar": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mado Capture: click to show the Capture Bar"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Mado 截图：点按显示截图工具条"}}}},
    "Choose": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择"}}}},
    "Choose the folder new captures are saved to.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose the folder new captures are saved to."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择新截图存放的文件夹。"}}}},
    "Saved to %@ · Copied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved to %@ · Copied"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已存到 %@ · 已拷贝"}}}},
    "Saved to %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved to %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已存到 %@"}}}},
    "Saved to %@ · Couldn't copy": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved to %@ · Couldn't copy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已存到 %@ · 无法拷贝"}}}},
    "Only on the clipboard · Not saved": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only on the clipboard · Not saved"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只在剪贴板里 · 没有存储"}}}},
    "Not saved · Not copied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not saved · Not copied"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有存储 · 没有拷贝"}}}},
    "Not saved · Couldn't copy": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not saved · Couldn't copy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "没有存储 · 无法拷贝"}}}},
    "Couldn't save · Copied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't save · Copied"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法存储 · 已拷贝"}}}},
    "Couldn't save · Not copied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't save · Not copied"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法存储 · 没有拷贝"}}}},
    "Couldn't save · Couldn't copy": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't save · Couldn't copy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法存储 · 无法拷贝"}}}},
    "Move to Trash": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Move to Trash"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "移到废纸篓"}}}},
    "Close Thumbnail": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Close Thumbnail"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭缩略图"}}}},
    "Capture Thumbnail %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Capture Thumbnail %@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "截图缩略图 %@"}}}},
    "Drag to another app": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Drag to another app"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拖到其他 App"}}}},
    "Couldn't move to the Trash": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't move to the Trash"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法移到废纸篓"}}}},
    "Open in Mado": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open in Mado"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在 Mado 中打开"}}}},
    "Couldn't open in Mado": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't open in Mado"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法在 Mado 中打开"}}}},
    "Couldn't open Mado": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't open Mado"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法打开 Mado"}}}},
    "Browsing Other Captures Needs Folder Access": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Browsing Other Captures Needs Folder Access"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "浏览其他截图需要授权截图文件夹"}}}},
    "Grant access to “%@” to page through your other captures with ←/→.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Grant access to “%@” to page through your other captures with ←/→."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "授权“%@”后，可以用 ←/→ 翻看其他截图。"}}}},
