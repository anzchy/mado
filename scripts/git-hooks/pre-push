#!/bin/sh
# Opt-in, seconds-only local checks. Git supplies pushed local OIDs on stdin.
# CI remains authoritative; Git's --no-verify bypasses this hook.
set -eu
# Installation must itself be launched from a trusted base copy (see README).
# A relative topic-worktree hooksPath cannot protect its own entry point.
if [ "${1:-}" = --install ]; then
  base=$(git rev-parse --verify "${2:-origin/main}^{commit}")
  common=$(git rev-parse --git-common-dir)
  common=$(cd "$common" && pwd)
  mkdir -p "$common/picsee-hook-snapshots"
  snapshot=$(mktemp -d "$common/picsee-hook-snapshots/base.XXXXXXXX")
  trap 'rm -rf "$snapshot"' 0
  trap 'exit 1' HUP INT TERM
  git archive --format=tar --output="$snapshot/input.tar" "$base"
  mkdir "$snapshot/tree"
  tar -xf "$snapshot/input.tar" -C "$snapshot/tree"
  for required in scripts/git-hooks/pre-push scripts/agents/local-pr-lint.mjs scripts/agents/ui-parity-pr-body-lint.mjs scripts/ledger/build.mjs scripts/design/shortcut-model.mjs; do
    [ -f "$snapshot/tree/$required" ] || { echo "pre-push: incomplete base: missing $required" >&2; exit 2; }
  done
  chmod +x "$snapshot/tree/scripts/git-hooks/pre-push"
  git config --local core.hooksPath "$snapshot/tree/scripts/git-hooks"
  trap - 0 HUP INT TERM
  echo "pre-push: installed base $base at $snapshot/tree/scripts/git-hooks"
  exit 0
fi
trusted=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$(git rev-parse --show-toplevel)"
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/picsee-pre-push.XXXXXXXX")
trap 'rm -rf "$snapshot"' 0
trap 'exit 1' HUP INT TERM

saw_input=0
while read -r local_ref local_oid remote_ref remote_oid; do
  saw_input=1
  # A deletion has no commit/body to validate (also supports SHA-256 zero OIDs).
  case "$local_oid" in
    '') echo 'pre-push: missing pushed local commit' >&2; exit 2 ;;
    *[!0]*) ;;
    *) continue ;;
  esac
  # Archive each pushed commit, including non-HEAD refs. Separate archive/extract
  # commands fail closed without a pipeline masking git failures. Each ref gets a
  # fresh directory so files deleted by the next commit cannot leak across checks.
  git archive --format=tar --output="$snapshot/input.tar" "$local_oid"
  mkdir "$snapshot/tree"
  tar -xf "$snapshot/input.tar" -C "$snapshot/tree"
  # Run base checkers with pushed data, even when topic scripts are weakened.
  rm -rf "$snapshot/tree/scripts"
  cp -R "$trusted/scripts" "$snapshot/tree/scripts"
  (
    cd "$snapshot/tree"
    node scripts/ledger/build.mjs --check
    node scripts/design/shortcut-model.mjs
  )
  rm -rf "$snapshot/tree"
  if [ -n "${PICSEE_PR_BODY:-}" ]; then
    node "$trusted/scripts/agents/local-pr-lint.mjs" --body-file "$PICSEE_PR_BODY" --expect "$local_oid"
  fi
done
if [ -n "${PICSEE_PR_BODY:-}" ] && [ "$saw_input" = 0 ]; then
  echo 'pre-push: no push input; cannot bind PR body to the pushed commit' >&2
  exit 2
fi
